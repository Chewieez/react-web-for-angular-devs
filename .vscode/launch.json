{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Open Course Homepage (Direct File)",
      "file": "${workspaceFolder}/index.html"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Open Active Lesson (Direct File)",
      "file": "${file}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch against Live Server (localhost:5500)",
      "url": "http://localhost:5500/index.html",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch against Dev Server (localhost:8080)",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}"
    }
  ]
}